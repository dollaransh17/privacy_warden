<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        3D bot mark. Layered painting order:
          1. Soft ground shadow
          2. Back / shadow side of head   (dark navy, adds depth through the eye cut-outs)
          3. Chat-bubble tail             (linear gradient)
          4. Front face plate             (bright-top to deep-bottom gradient, evenOdd cuts eyes + mouth)
          5. Glowing cyan eye LEDs
          6. Antenna stem                 (metallic side-to-side gradient)
          7. Antenna ball                 (top-to-bottom highlight)
          8. Small specular dot on the ball
        The front plate uses fillType=evenOdd so the eye holes reveal the DARKER
        back-head behind, producing an inset-socket look without needing masks.
    -->

    <!-- 1. Soft ground shadow -->
    <path
        android:fillColor="#332563EB"
        android:pathData="M5.8,21.6 a 6.2,0.9 0 1 0 12.4,0 a 6.2,0.9 0 1 0 -12.4,0 Z" />

    <!-- 2. Back / shadow head (slightly offset to give depth behind the face) -->
    <path
        android:fillColor="#FF1E3A8A"
        android:pathData="M7.4,5.4 h 10 a 3,3 0 0 1 3,3 v 6 a 3,3 0 0 1 -3,3 h -10 a 3,3 0 0 1 -3,-3 v -6 a 3,3 0 0 1 3,-3 Z" />

    <!-- 3. Chat-bubble tail -->
    <path android:pathData="M8,16 L 4.8,21.2 L 11,16.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4.8" android:startY="21.2"
                android:endX="11" android:endY="16.5"
                android:startColor="#FF1E40AF"
                android:endColor="#FF3B82F6" />
        </aapt:attr>
    </path>

    <!-- 4. Front face plate with eye + mouth cut-outs -->
    <path
        android:fillType="evenOdd"
        android:pathData="M7,5 h 10 a 3,3 0 0 1 3,3 v 6 a 3,3 0 0 1 -3,3 h -10 a 3,3 0 0 1 -3,-3 v -6 a 3,3 0 0 1 3,-3 Z M9.3,11.5 a 1.3,1.3 0 1 0 2.6,0 a 1.3,1.3 0 1 0 -2.6,0 Z M13.3,11.5 a 1.3,1.3 0 1 0 2.6,0 a 1.3,1.3 0 1 0 -2.6,0 Z M10,13.7 h 4 v 0.6 h -4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="5"
                android:endX="12" android:endY="17"
                android:startColor="#FFBFDBFE"
                android:endColor="#FF2563EB" />
        </aapt:attr>
    </path>

    <!-- 5. Glowing cyan eye LEDs inside the sockets -->
    <path android:pathData="M10.2,11.1 a 0.55,0.55 0 1 0 1.1,0 a 0.55,0.55 0 1 0 -1.1,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="10.2" android:startY="10.55"
                android:endX="11.3" android:endY="11.65"
                android:startColor="#FFE0F2FE"
                android:endColor="#FF38BDF8" />
        </aapt:attr>
    </path>
    <path android:pathData="M14.2,11.1 a 0.55,0.55 0 1 0 1.1,0 a 0.55,0.55 0 1 0 -1.1,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14.2" android:startY="10.55"
                android:endX="15.3" android:endY="11.65"
                android:startColor="#FFE0F2FE"
                android:endColor="#FF38BDF8" />
        </aapt:attr>
    </path>

    <!-- 6. Antenna stem (metallic, lit from the left) -->
    <path android:pathData="M11.3,2.7 h 1.4 v 2.6 h -1.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="11.3" android:startY="4"
                android:endX="12.7" android:endY="4"
                android:startColor="#FF93C5FD"
                android:endColor="#FF1E3A8A" />
        </aapt:attr>
    </path>

    <!-- 7. Antenna ball (top-lit) -->
    <path android:pathData="M10.7,1.5 a 1.3,1.3 0 1 0 2.6,0 a 1.3,1.3 0 1 0 -2.6,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="0.2"
                android:endX="12" android:endY="2.8"
                android:startColor="#FFFFFFFF"
                android:endColor="#FF1E40AF" />
        </aapt:attr>
    </path>

    <!-- 8. Specular highlight dot on the antenna ball -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.5,1 a 0.35,0.35 0 1 0 0.7,0 a 0.35,0.35 0 1 0 -0.7,0 Z" />
</vector>
